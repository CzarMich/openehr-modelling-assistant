{
    admin off
    auto_https off
    persist_config off
}
:8343 {
    request_body {
        max_size {$MAX_REQUEST_BYTES:2097152}
    }
    @chat path /chat /chat/*
    handle @chat {
        reverse_proxy chat:8350 {
            flush_interval -1
            transport http {
                response_header_timeout 30s
                read_timeout 600s
            }
        }
    }
    handle / {
        root * /srv
        rewrite * /landing.html
        file_server
    }
    @mcp path /mcp /health /ready /api/v1/reviews /api/v1/reviews/*
    handle @mcp {
        reverse_proxy app:9000 {
            transport fastcgi {
                env SCRIPT_FILENAME /app/public/index.php
                env SCRIPT_NAME /index.php
                env HTTP_HOST {http.request.hostport}
                read_timeout 120s
            }
        }
    }
    handle {
        respond 404
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        -Server
    }
}
